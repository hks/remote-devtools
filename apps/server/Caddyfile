# SITE_ADDRESS:
#   local  → ":80"                    (plain HTTP, no TLS)
#   server → "devtools.example.com"   (automatic TLS via Let's Encrypt; 80/443 must be publicly reachable)
{$SITE_ADDRESS::80} {
	encode zstd gzip
	# WebSocket upgrades are proxied automatically by reverse_proxy.
	reverse_proxy relay:8080
}
