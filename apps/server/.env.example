# ─── Local ───────────────────────────────────────────────────────────────────
# Address the phone will reach. Locally, the LAN IP or a tunnel (ngrok/cloudflared) address.
# If left empty, the web UI puts its own origin into the QR.
PUBLIC_URL=http://192.168.1.10:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# ─── Server (example) ────────────────────────────────────────────────────────
# PUBLIC_URL=https://devtools.example.com
# SITE_ADDRESS=devtools.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# ─── Relay settings ──────────────────────────────────────────────────────────
SESSION_TTL_HOURS=24
PAIR_TOKEN_TTL_SEC=120
DEVICE_IDLE_TTL_MIN=60
# Development connections without a code/QR: off | local | any. Must stay "off" on a public server.
CONNECT_REQUESTS=off
CONNECT_REQUEST_TTL_SEC=120
HEARTBEAT_INTERVAL_SEC=15
MAX_PAYLOAD_MB=5
MAX_SESSIONS=1000
MAX_DEVICES_PER_SESSION=20
DEVICE_MAX_MSGS_PER_SEC=200
PAIR_FAILURE_LIMIT=10
PAIR_FAILURE_WINDOW_SEC=600
