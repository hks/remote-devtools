{
  "name": "@himmetkaan/remote-devtools",
  "version": "0.1.0",
  "description": "Remote DevTools SDK for React Native, Expo, browsers and Node: logs, network, state, storage, flags and custom panels in a desktop or web UI.",
  "keywords": [
    "remote-devtools",
    "devtools",
    "react-native",
    "expo",
    "debugging",
    "network-inspector",
    "logger",
    "feature-flags"
  ],
  "homepage": "https://hks.github.io/remote-devtools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hks/remote-devtools.git",
    "directory": "packages/sdk-js"
  },
  "bugs": "https://github.com/hks/remote-devtools/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "node ../../scripts/build-lib.ts"
  },
  "dependencies": {
    "@himmetkaan/remote-devtools-protocol": "workspace:*"
  },
  "devDependencies": {
    "@himmetkaan/remote-devtools-relay": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
