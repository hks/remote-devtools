{
  "name": "@himmetkaan/remote-devtools-protocol",
  "version": "0.1.0",
  "description": "Wire protocol types, field DSL and helpers for Remote DevTools (relay, UI and SDKs).",
  "keywords": [
    "remote-devtools",
    "devtools",
    "protocol",
    "websocket"
  ],
  "homepage": "https://hks.github.io/remote-devtools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hks/remote-devtools.git",
    "directory": "packages/protocol"
  },
  "bugs": "https://github.com/hks/remote-devtools/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "node ../../scripts/build-lib.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
