{
  "name": "@himmetkaan/remote-devtools-protocol",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "node ../../scripts/build-lib.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
