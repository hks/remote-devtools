{
  "name": "remote-devtools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:relay": "pnpm --filter @himmetkaan/remote-devtools-relay dev",
    "dev:ui": "pnpm --filter @himmetkaan/remote-devtools-ui dev",
    "dev:example": "pnpm --filter @himmetkaan/remote-devtools-example-web dev",
    "pack:sdk": "node scripts/pack-sdk.ts",
    "dev:desktop": "pnpm --filter @himmetkaan/remote-devtools-desktop start",
    "dist:desktop": "pnpm --filter @himmetkaan/remote-devtools-desktop dist",
    "docs:dev": "pnpm --filter @himmetkaan/remote-devtools-docs dev",
    "docs:build": "pnpm --filter @himmetkaan/remote-devtools-docs build"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
