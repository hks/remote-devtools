{
  "name": "remote-devtools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:relay": "pnpm --filter @himmetkaan/remote-devtools-relay dev",
    "dev:ui": "pnpm --filter @himmetkaan/remote-devtools-ui dev",
    "dev:example": "pnpm --filter @himmetkaan/remote-devtools-example-web dev",
    "pack:sdk": "node scripts/pack-sdk.ts",
    "dev:desktop": "pnpm --filter @himmetkaan/remote-devtools-desktop start",
    "dist:desktop": "pnpm --filter @himmetkaan/remote-devtools-desktop dist",
    "docs:dev": "pnpm --filter @himmetkaan/remote-devtools-docs dev",
    "docs:build": "pnpm --filter @himmetkaan/remote-devtools-docs build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-sdk-version.ts && pnpm install --lockfile-only",
    "release": "pnpm --filter @himmetkaan/remote-devtools-protocol --filter @himmetkaan/remote-devtools build && changeset publish",
    "dist:desktop:signed": "pnpm --filter @himmetkaan/remote-devtools-desktop dist:signed"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "esbuild": "0.28.2"
  }
}
