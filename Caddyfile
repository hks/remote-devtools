# SITE_ADDRESS:
#   lokal  → ":80"                    (düz HTTP, TLS yok)
#   sunucu → "devtools.example.com"   (Let's Encrypt ile otomatik TLS; 80/443 dışarı açık olmalı)
{$SITE_ADDRESS::80} {
	encode zstd gzip
	# WebSocket upgrade'leri reverse_proxy tarafından otomatik taşınır.
	reverse_proxy relay:8080
}
