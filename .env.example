# ─── Lokal ───────────────────────────────────────────────────────────────────
# Telefonun ulaşacağı adres. Lokalde LAN IP'si veya tünel (ngrok/cloudflared) adresi.
# Boş bırakılırsa web, QR'a kendi açıldığı origin'i yazar.
PUBLIC_URL=http://192.168.1.10:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# ─── Sunucu (örnek) ──────────────────────────────────────────────────────────
# PUBLIC_URL=https://devtools.example.com
# SITE_ADDRESS=devtools.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# ─── Relay ayarları ──────────────────────────────────────────────────────────
SESSION_TTL_HOURS=24
PAIR_TOKEN_TTL_SEC=120
HEARTBEAT_INTERVAL_SEC=15
MAX_PAYLOAD_MB=5
MAX_SESSIONS=1000
